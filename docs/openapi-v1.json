  "info": {
    "description": "Search Audible's catalog, request audiobooks and follow them until they're in the library. See docs/api.md in the Narratarr repository for the full guide.",
    "title": "Narratarr API",
    "version": "1"
  },
  "openapi": "3.1.0",
